<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="https://defs.dev.algites.eu/api/xmldefs/eu/algites/lib/naming/convention/sourcecode/source-structure-name-conventions_1.xsd"
           version="1"
           xmlns:common="https://defs.dev.algites.eu/api/xmldefs/eu/algites/lib/naming/convention/common-naming-conventions_1.xsd"
           xmlns:container="https://defs.dev.algites.eu/api/xmldefs/eu/algites/lib/naming/convention/sourcecode/container-structure-type_1.xsd"
           xmlns:kind="https://defs.dev.algites.eu/api/xmldefs/eu/algites/lib/naming/convention/sourcecode/source-structure-kind_1.xsd">
  <xs:annotation>
    <xs:documentation>Named source-structure profiles. NameConventions and StructureNaming are typed maps with unique keys.</xs:documentation>
  </xs:annotation>
  <xs:import namespace="https://defs.dev.algites.eu/api/xmldefs/eu/algites/lib/naming/convention/common-naming-conventions_1.xsd" schemaLocation="https://defs.dev.algites.eu/api/xmldefs/eu/algites/lib/naming/convention/common-naming-conventions_1.xsd"/>
  <xs:import namespace="https://defs.dev.algites.eu/api/xmldefs/eu/algites/lib/naming/convention/sourcecode/container-structure-type_1.xsd" schemaLocation="container-structure-type_1.xsd"/>
  <xs:import namespace="https://defs.dev.algites.eu/api/xmldefs/eu/algites/lib/naming/convention/sourcecode/source-structure-kind_1.xsd" schemaLocation="source-structure-kind_1.xsd"/>
  <xs:complexType name="SourceStructureNameConventions">
    <xs:complexContent>
      <xs:extension base="common:CommonNamingConventions">
        <xs:sequence>
          <xs:element name="SourceStructureNameConventions">
            <xs:complexType>
              <xs:sequence>
                <xs:element name="NameConventions">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="NameConvention" minOccurs="0" maxOccurs="unbounded">
                        <xs:complexType>
                          <xs:sequence>
                            <xs:element name="ContainerStructureType" type="container:ContainerStructureType"/>
                            <xs:element name="StructureNaming">
                              <xs:complexType>
                                <xs:sequence>
                                  <xs:element name="Rule" minOccurs="0" maxOccurs="unbounded">
                                    <xs:complexType>
                                      <xs:simpleContent>
                                        <xs:extension base="xs:string">
                                          <xs:attribute name="kind" type="kind:SourceStructureKind" use="required"/>
                                        </xs:extension>
                                      </xs:simpleContent>
                                    </xs:complexType>
                                  </xs:element>
                                </xs:sequence>
                              </xs:complexType>
                              <xs:key name="UniqueStructureKinds">
                                <xs:selector xpath="Rule"/>
                                <xs:field xpath="@kind"/>
                              </xs:key>
                            </xs:element>
                          </xs:sequence>
                          <xs:attribute name="name" type="xs:string" use="required"/>
                        </xs:complexType>
                      </xs:element>
                    </xs:sequence>
                  </xs:complexType>
                  <xs:key name="UniqueNameConventions">
                    <xs:selector xpath="NameConvention"/>
                    <xs:field xpath="@name"/>
                  </xs:key>
                </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
</xs:schema>
