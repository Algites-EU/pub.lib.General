<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:common="https://defs.dev.algites.eu/api/xmldefs/eu/algites/lib/naming/convention/common-naming-conventions_1.xsd" xmlns:role="https://defs.dev.algites.eu/api/xmldefs/eu/algites/lib/naming/convention/sourcecode/dataobject/dataobject-schema-metadata-kind_1.xsd" xmlns:tns="https://defs.dev.algites.eu/api/xmldefs/eu/algites/lib/naming/convention/sourcecode/dataobject/dataobject-naming-conventions_1.xsd" targetNamespace="https://defs.dev.algites.eu/api/xmldefs/eu/algites/lib/naming/convention/sourcecode/dataobject/dataobject-naming-conventions_1.xsd" version="1">
  <xs:annotation>
    <xs:documentation>DataObject schema-metadata field naming profiles, separately typed from the other naming domain. XML entries encode named maps as Rule elements with unique role keys.</xs:documentation>
  </xs:annotation>
  <xs:import namespace="https://defs.dev.algites.eu/api/xmldefs/eu/algites/lib/naming/convention/common-naming-conventions_1.xsd" schemaLocation="https://defs.dev.algites.eu/api/xmldefs/eu/algites/lib/naming/convention/common-naming-conventions_1.xsd"/>
  <xs:import namespace="https://defs.dev.algites.eu/api/xmldefs/eu/algites/lib/naming/convention/sourcecode/dataobject/dataobject-schema-metadata-kind_1.xsd" schemaLocation="dataobject-schema-metadata-kind_1.xsd"/>
  <xs:complexType name="DataobjectNamingConventions">
    <xs:complexContent>
      <xs:extension base="common:CommonNamingConventions">
        <xs:sequence>
          <xs:element name="DataObjectNameConventions">
            <xs:complexType>
              <xs:sequence>
                <xs:element name="NameConventions">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="NameConvention" minOccurs="0" maxOccurs="unbounded" type="tns:DataObjectNameConvention"/>
                    </xs:sequence>
                  </xs:complexType>
                  <xs:key name="UniqueNamingProfiles">
                    <xs:selector xpath="NameConvention"/>
                    <xs:field xpath="@name"/>
                  </xs:key>
                </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="DataObjectNameConvention">
    <xs:sequence>
      <xs:element name="StructureNaming">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Rule" minOccurs="0" maxOccurs="unbounded" type="tns:DataObjectStructureNamingRule"/>
          </xs:sequence>
        </xs:complexType>
        <xs:key name="UniqueNamingRoles">
          <xs:selector xpath="Rule"/>
          <xs:field xpath="@kind"/>
        </xs:key>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="name" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="DataObjectStructureNamingRule">
    <xs:sequence>
      <xs:element name="Value" type="xs:string"/>
    </xs:sequence>
    <xs:attribute name="kind" type="role:DataobjectSchemaMetadataKind" use="required"/>
  </xs:complexType>
</xs:schema>
