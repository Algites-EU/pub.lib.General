  "title": "DataObject naming conventions",
  "description": "Reusable DataObject schema metadata naming profiles. Does not specify generated accessor names.",
  "x-algites-schema-id": "eu.algites.lib.naming.convention.sourcecode.dataobject.dataobject-naming-conventions",
  "x-algites-schema-version": 1,
  "x-algites-defscodegen-extends": [
    "https://defs.dev.algites.eu/api/yamldefs/eu/algites/lib/naming/convention/common-naming-conventions_1.yamldef.schema.json"
  ],
  "allOf": [
    {
      "$ref": "https://defs.dev.algites.eu/api/yamldefs/eu/algites/lib/naming/convention/common-naming-conventions_1.yamldef.schema.json"
    }
  ],
  "properties": {
    "DataObjectNameConventions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "NameConventions": {
          "type": "object",
          "title": "Named profiles",
          "description": "",
          "additionalProperties": false,
          "properties": {
            "NameConvention": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/DataObjectNameConvention"
              },
              "description": "Ordered XSD NameConvention elements; name is an identity attribute.",
              "x-algites-defscodegen-key": {
                "id": "UniqueNamingProfiles",
                "field-name": "name"
              }
            }
          }
        }
      },
      "required": [
        "NameConventions"
      ]
    }
  },
  "type": "object",
  "required": [
    "DataObjectNameConventions"
  ],
  "$defs": {
    "DataObjectNameConvention": {
      "type": "object",
      "title": "DataObject naming profile",
      "description": "One named profile of DataObject schema metadata field mappings.",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Required XSD identity attribute."
        },
        "StructureNaming": {
          "type": "object",
          "title": "DataObject schema metadata naming",
          "description": "Maps metadata roles to names of fields in source schema definitions and serialized documents. Empty mappings disable the corresponding role. YAML empty values (null) are accepted as disabled mappings.",
          "additionalProperties": false,
          "properties": {
            "Rule": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/DataObjectStructureNamingRule"
              },
              "x-algites-defscodegen-key": {
                "id": "UniqueNamingRoles",
                "field-name": "kind"
              }
            }
          }
        }
      },
      "required": [
        "name",
        "StructureNaming"
      ]
    },
    "DataObjectStructureNamingRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "dataobject-schema-metadata-kind_1.yamldef.schema.json"
        },
        "Value": {
          "type": [
            "string",
            "null"
          ],
          "description": "A metadata field name; null or the empty string disables this mapping."
        }
      },
      "required": [
        "kind",
        "Value"
      ]
    }
  }
