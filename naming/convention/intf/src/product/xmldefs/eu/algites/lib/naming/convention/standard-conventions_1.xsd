<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:algdoc="https://defs.dev.algites.eu/api/xmldefs/eu/algites/lib/common/documentation/algites-documentation_1.xsd" xmlns:common="https://defs.dev.algites.eu/api/xmldefs/eu/algites/lib/naming/convention/common-naming-conventions_1.xsd" targetNamespace="https://defs.dev.algites.eu/api/xmldefs/eu/algites/lib/naming/convention/standard-conventions_1.xsd" version="1">
	<xs:annotation>
		<xs:appinfo>
			<algdoc:title>Standard conventions</algdoc:title>
		</xs:appinfo>
		<xs:documentation>Reusable regular expressions with named capture groups. Regex syntax canonicalized from Java named groups.
		</xs:documentation>
	</xs:annotation>
	<xs:import namespace="https://defs.dev.algites.eu/api/xmldefs/eu/algites/lib/common/documentation/algites-documentation_1.xsd" schemaLocation="https://defs.dev.algites.eu/api/xmldefs/eu/algites/lib/common/documentation/algites-documentation_1.xsd"/>
	<xs:import namespace="https://defs.dev.algites.eu/api/xmldefs/eu/algites/lib/naming/convention/common-naming-conventions_1.xsd" schemaLocation="common-naming-conventions_1.xsd"/>
	<xs:complexType name="StandardConventions">
		<xs:annotation>
			<xs:appinfo>
				<algdoc:title>Standard conventions</algdoc:title>
			</xs:appinfo>
			<xs:documentation>Reusable regular expressions with named capture groups. Regex syntax canonicalized from Java named groups.
			</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:restriction base="common:CommonNamingConventions">
				<xs:sequence>
					<xs:element name="IdentifierConventions" type="common:IdentifierConventions">
						<xs:key name="UniqueIdentifierConventionNames">
							<xs:selector xpath="IdentifierConvention"/>
							<xs:field xpath="@name"/>
						</xs:key>
					</xs:element>
					<xs:element name="VersionConventions" type="common:VersionConventions">
						<xs:key name="UniqueVersionConventionNames">
							<xs:selector xpath="VersionConvention"/>
							<xs:field xpath="@name"/>
						</xs:key>
					</xs:element>
				</xs:sequence>
			</xs:restriction>
		</xs:complexContent>
	</xs:complexType>
</xs:schema>
