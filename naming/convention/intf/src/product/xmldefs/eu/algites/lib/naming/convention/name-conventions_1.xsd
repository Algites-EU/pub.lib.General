<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:algdoc="urn:eu:algites:documentation:1" targetNamespace="eu.algites.lib.naming.convention.name-conventions" version="1">
  <xs:annotation>
    <xs:appinfo>
      <algdoc:title>Name conventions</algdoc:title>
    </xs:appinfo>
    <xs:documentation>Reusable fragments, compositions and container-specific structure naming profiles.</xs:documentation>
  </xs:annotation>
  <xs:import namespace="urn:eu:algites:documentation:1" schemaLocation="https://defs.dev.algites.eu/api/xmldefs/eu/algites/lib/common/documentation/algites-documentation_1.xsd"/>
  <xs:complexType name="name-conventions">
    <xs:annotation>
      <xs:appinfo>
        <algdoc:title>Name conventions</algdoc:title>
      </xs:appinfo>
      <xs:documentation>Reusable fragments, compositions and container-specific structure naming profiles.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="StandardConventionsFile" minOccurs="0" type="xs:anyType">
        <xs:annotation>
          <xs:appinfo>
            <algdoc:title>Standard conventions file</algdoc:title>
          </xs:appinfo>
          <xs:documentation>Relative path to the file containing shared identifier and version convention definitions.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="IdentifierConventions" minOccurs="0" type="xs:anyType">
        <xs:annotation>
          <xs:appinfo>
            <algdoc:title>Identifier conventions</algdoc:title>
          </xs:appinfo>
          <xs:documentation>Named identifier conventions whose regular expressions validate or recognize identifiers.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="VersionConventions" minOccurs="0" type="xs:anyType">
        <xs:annotation>
          <xs:appinfo>
            <algdoc:title>Version conventions</algdoc:title>
          </xs:appinfo>
          <xs:documentation>Named version conventions whose regular expressions recognize version components.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="NameFragments" minOccurs="0" type="xs:anyType">
        <xs:annotation>
          <xs:appinfo>
            <algdoc:title>Name fragments</algdoc:title>
          </xs:appinfo>
          <xs:documentation>Reusable named sequences of text, identifier, version or variable segments.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="NameCompositions" minOccurs="0" type="xs:anyType">
        <xs:annotation>
          <xs:appinfo>
            <algdoc:title>Name compositions</algdoc:title>
          </xs:appinfo>
          <xs:documentation>Named compositions that combine reusable fragments into full names.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="NameConventions" minOccurs="0" type="xs:anyType">
        <xs:annotation>
          <xs:appinfo>
            <algdoc:title>Name conventions</algdoc:title>
          </xs:appinfo>
          <xs:documentation>Naming rules for supported container structures and their contained source elements.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
