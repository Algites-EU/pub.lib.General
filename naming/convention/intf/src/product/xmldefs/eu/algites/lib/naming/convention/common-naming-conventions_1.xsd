<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:tns="https://defs.dev.algites.eu/api/xmldefs/eu/algites/lib/naming/convention/common-naming-conventions_1.xsd" targetNamespace="https://defs.dev.algites.eu/api/xmldefs/eu/algites/lib/naming/convention/common-naming-conventions_1.xsd" version="1">
  <xs:annotation>
    <xs:documentation>Reusable tools shared by any naming-convention profile family.</xs:documentation>
  </xs:annotation>
  <xs:complexType name="CommonNamingConventions">
    <xs:sequence>
      <xs:element name="StandardConventionsFile" minOccurs="0" type="xs:string">
        <xs:annotation>
          <xs:documentation>Optional reference to standard identifier/version definitions.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="IdentifierConventions" minOccurs="0" type="tns:IdentifierConventions">
        <xs:annotation>
          <xs:documentation>Named identifier conventions.</xs:documentation>
        </xs:annotation>
        <xs:key name="UniqueIdentifierConventionNames">
          <xs:selector xpath="IdentifierConvention"/>
          <xs:field xpath="@name"/>
        </xs:key>
      </xs:element>
      <xs:element name="VersionConventions" minOccurs="0" type="tns:VersionConventions">
        <xs:annotation>
          <xs:documentation>Named version conventions.</xs:documentation>
        </xs:annotation>
        <xs:key name="UniqueVersionConventionNames">
          <xs:selector xpath="VersionConvention"/>
          <xs:field xpath="@name"/>
        </xs:key>
      </xs:element>
      <xs:element name="NameFragments" minOccurs="0" type="tns:NameFragments">
        <xs:annotation>
          <xs:documentation>Reusable fragment definitions.</xs:documentation>
        </xs:annotation>
        <xs:key name="UniqueNameFragmentNames">
          <xs:selector xpath="NameFragment"/>
          <xs:field xpath="@name"/>
        </xs:key>
      </xs:element>
      <xs:element name="NameCompositions" minOccurs="0" type="tns:NameCompositions">
        <xs:annotation>
          <xs:documentation>Reusable name composition definitions.</xs:documentation>
        </xs:annotation>
        <xs:key name="UniqueNameCompositionNames">
          <xs:selector xpath="NameComposition"/>
          <xs:field xpath="@name"/>
        </xs:key>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="NameFragmentsSegmentReference">
    <xs:sequence>
      <xs:element name="Ref" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>
  <!-- Named enums are preferred for reusable XSD contracts. -->
  <xs:simpleType name="NameFragmentsSegmentValueKind">
    <xs:restriction base="xs:string">
      <xs:enumeration value="constant_string"/>
      <xs:enumeration value="identifier"/>
      <xs:enumeration value="version"/>
      <xs:enumeration value="variable"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="NameFragmentsSegmentValue">
    <xs:sequence>
      <xs:element name="Kind" type="tns:NameFragmentsSegmentValueKind"/>
      <!-- Exactly one alternative; Name and Regexp are an inseparable pair. -->
      <xs:element name="Content" type="tns:NameFragmentsSegmentValueContent"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="NameFragmentsSegmentChoice">
    <xs:choice>
      <!-- Named variants match JSONDEFS/YAMLDEFS choice properties. -->
      <xs:element name="NameFragmentsSegmentReference" type="tns:NameFragmentsSegmentReference"/>
      <xs:element name="NameFragmentsSegmentValue" type="tns:NameFragmentsSegmentValue"/>
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="IdentifierConventions">
    <xs:sequence>
      <xs:element name="IdentifierConvention" minOccurs="0" maxOccurs="unbounded" type="tns:IdentifierConvention"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="VersionConventions">
    <xs:sequence>
      <xs:element name="VersionConvention" minOccurs="0" maxOccurs="unbounded" type="tns:VersionConvention"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="NameFragments">
    <xs:sequence>
      <xs:element name="NameFragment" minOccurs="0" maxOccurs="unbounded" type="tns:NameFragment"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="NameCompositions">
    <xs:sequence>
      <xs:element name="NameComposition" minOccurs="0" maxOccurs="unbounded" type="tns:NameComposition"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="IdentifierConvention">
    <xs:sequence>
      <xs:element name="Regexp" type="xs:string"/>
      <xs:element name="ConversionStyle" minOccurs="0" type="tns:IdentifierConversionStyle"/>
    </xs:sequence>
    <xs:attribute name="name" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="VersionConvention">
    <xs:sequence>
      <xs:element name="Regexp" type="xs:string"/>
    </xs:sequence>
    <xs:attribute name="name" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="NameFragment">
    <xs:sequence>
      <xs:element name="Segments" minOccurs="1" maxOccurs="unbounded" type="tns:NameFragmentsSegmentChoice"/>
    </xs:sequence>
    <xs:attribute name="name" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="NameComposition">
    <xs:sequence>
      <xs:element name="Segments" minOccurs="1" maxOccurs="unbounded" type="tns:NameFragmentsSegmentChoice"/>
    </xs:sequence>
    <xs:attribute name="name" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="NameFragmentsSegmentValueContent">
    <xs:choice>
      <xs:element name="Value" type="xs:string"/>
      <xs:element name="Convention" type="xs:string"/>
      <xs:element name="CustomConventionRegexp" type="xs:string"/>
      <xs:element name="NameRegexp" type="tns:NameRegexp"/>
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="NameRegexp">
    <xs:sequence>
      <xs:element name="Name" type="xs:string"/>
      <xs:element name="Regexp" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="IdentifierConversionStyle">
    <xs:restriction base="xs:string">
      <xs:enumeration value="lower_flat"/>
      <xs:enumeration value="upper_flat"/>
      <xs:enumeration value="lower_snake"/>
      <xs:enumeration value="upper_snake"/>
      <xs:enumeration value="lower_camel"/>
      <xs:enumeration value="upper_camel"/>
      <xs:enumeration value="lower_kebab"/>
      <xs:enumeration value="upper_kebab"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
