<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="eu.algites.lib.naming.convention.common-naming-conventions" version="1">
  <xs:annotation>
    <xs:documentation>Reusable tools shared by any naming-convention profile family.</xs:documentation>
  </xs:annotation>
  <xs:complexType name="common-naming-conventions">
    <xs:sequence>
      <xs:element name="StandardConventionsFile" minOccurs="0" type="xs:string">
        <xs:annotation>
          <xs:documentation>Optional reference to standard identifier/version definitions.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="IdentifierConventions" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Named identifier conventions.</xs:documentation>
        </xs:annotation>
      <xs:complexType>
        <xs:sequence>
          <xs:element name="IdentifierConvention" minOccurs="0" maxOccurs="unbounded">
            <xs:complexType><xs:sequence><xs:element name="Regexp" type="xs:string"/><xs:element name="ConversionStyle" minOccurs="0">
            <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="lower_flat"/><xs:enumeration value="upper_flat"/><xs:enumeration value="lower_snake"/><xs:enumeration value="upper_snake"/><xs:enumeration value="lower_camel"/><xs:enumeration value="upper_camel"/><xs:enumeration value="lower_kebab"/><xs:enumeration value="upper_kebab"/></xs:restriction></xs:simpleType>
            </xs:element></xs:sequence>
              <xs:attribute name="name" type="xs:string" use="required"/>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:key name="UniqueIdentifierConventionNames"><xs:selector xpath="IdentifierConvention"/><xs:field xpath="@name"/></xs:key></xs:element>
      <xs:element name="VersionConventions" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Named version conventions.</xs:documentation>
        </xs:annotation>
      <xs:complexType>
        <xs:sequence>
          <xs:element name="VersionConvention" minOccurs="0" maxOccurs="unbounded">
            <xs:complexType><xs:sequence><xs:element name="Regexp" type="xs:string"/></xs:sequence>
              <xs:attribute name="name" type="xs:string" use="required"/>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:key name="UniqueVersionConventionNames"><xs:selector xpath="VersionConvention"/><xs:field xpath="@name"/></xs:key></xs:element>
      <xs:element name="NameFragments" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Reusable fragment definitions.</xs:documentation>
        </xs:annotation>
      <xs:complexType>
        <xs:sequence>
          <xs:element name="NameFragment" minOccurs="0" maxOccurs="unbounded">
            <xs:complexType><xs:sequence><xs:element name="Segments"><xs:complexType><xs:sequence>
          <xs:element name="Segment" minOccurs="1" maxOccurs="unbounded">
            <xs:complexType>
              <xs:choice>
                <!-- A reference cannot contain any inline segment fields. -->
                <xs:element name="Ref" type="xs:string"/>
                <xs:sequence>
                  <xs:element name="Kind">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:enumeration value="constant_string"/>
                        <xs:enumeration value="identifier"/>
                        <xs:enumeration value="version"/>
                        <xs:enumeration value="variable"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <!-- Exactly one alternative; Name and Regexp are an inseparable pair. -->
                  <xs:choice>
                    <xs:element name="Value" type="xs:string"/>
                    <xs:element name="Convention" type="xs:string"/>
                    <xs:element name="CustomConventionRegexp" type="xs:string"/>
                    <xs:sequence>
                      <xs:element name="Name" type="xs:string"/>
                      <xs:element name="Regexp" type="xs:string"/>
                    </xs:sequence>
                  </xs:choice>
                </xs:sequence>
              </xs:choice>
            </xs:complexType>
          </xs:element>
        </xs:sequence></xs:complexType></xs:element></xs:sequence>
              <xs:attribute name="name" type="xs:string" use="required"/>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:key name="UniqueNameFragmentNames"><xs:selector xpath="NameFragment"/><xs:field xpath="@name"/></xs:key></xs:element>
      <xs:element name="NameCompositions" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Reusable name composition definitions.</xs:documentation>
        </xs:annotation>
      <xs:complexType>
        <xs:sequence>
          <xs:element name="NameComposition" minOccurs="0" maxOccurs="unbounded">
            <xs:complexType><xs:sequence><xs:element name="Segments"><xs:complexType><xs:sequence>
          <xs:element name="Segment" minOccurs="1" maxOccurs="unbounded">
            <xs:complexType>
              <xs:choice>
                <!-- A reference cannot contain any inline segment fields. -->
                <xs:element name="Ref" type="xs:string"/>
                <xs:sequence>
                  <xs:element name="Kind">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:enumeration value="constant_string"/>
                        <xs:enumeration value="identifier"/>
                        <xs:enumeration value="version"/>
                        <xs:enumeration value="variable"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <!-- Exactly one alternative; Name and Regexp are an inseparable pair. -->
                  <xs:choice>
                    <xs:element name="Value" type="xs:string"/>
                    <xs:element name="Convention" type="xs:string"/>
                    <xs:element name="CustomConventionRegexp" type="xs:string"/>
                    <xs:sequence>
                      <xs:element name="Name" type="xs:string"/>
                      <xs:element name="Regexp" type="xs:string"/>
                    </xs:sequence>
                  </xs:choice>
                </xs:sequence>
              </xs:choice>
            </xs:complexType>
          </xs:element>
        </xs:sequence></xs:complexType></xs:element></xs:sequence>
              <xs:attribute name="name" type="xs:string" use="required"/>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:key name="UniqueNameCompositionNames"><xs:selector xpath="NameComposition"/><xs:field xpath="@name"/></xs:key></xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>